[Unit]
Description=Merchant Bridge daily blog publishing job
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/merchantbridge/merchantbridge-cron.env
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 300 -H "Authorization: Bearer ${CRON_SECRET}" https://www.demerchantbridge.com/api/cron/blog
