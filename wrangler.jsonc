{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "merchantbridge",
  "compatibility_date": "2025-01-01",
  "workers_dev": true,
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "merchantbridge"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "env": {
    "production": {
      "name": "merchantbridge-production",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "merchantbridge-production"
        }
      ],
      "images": {
        "binding": "IMAGES"
      }
    }
  }
}
