{
  "name": "merchantbridge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/content/prepare-library.mjs && next build --webpack",
    "build:cloudflare": "node scripts/content/prepare-library.mjs && npx opennextjs-cloudflare build",
    "dev:cloudflare": "OPENNEXT_DEV=true next dev",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "npx opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint .",
    "content:generate": "node scripts/content/generate-library.mjs && node scripts/content/build-library.mjs",
    "merchantbridge": "node scripts/merchantbridge-cli.mjs",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@netlify/database": "^2.0.1",
    "@netlify/plugin-nextjs": "^5.15.13",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "country-flag-icons": "^1.6.20",
    "drizzle-orm": "^1.0.0-beta.22",
    "fast-xml-parser": "^5.11.1",
    "googleapis": "^176.0.0",
    "i18n-iso-countries": "^7.14.0",
    "jspdf": "^4.2.1",
    "next": "^16.3.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "resend": "^6.21.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.10",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^1.0.0-beta.22",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.38",
    "supabase": "^2.118.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "wrangler": "^4.149.0"
  }
}
